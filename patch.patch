--- /dev/null
+++ b/src/lib/notifications.js
@@ -0,0 +1,51 @@
+// In-app notification access for the signed-in user (the notifications
+// table, migration 0004). RLS isolates rows per user on the server — these
+// helpers only ever see the caller's own notifications. Everything degrades
+// to null/[] when the backend is not configured.
+
+import { supabase, backendConfigured } from './backend.js';
+
+const COLUMNS = 'id, type, contribution_number, title, entry_id, entry_series, message, read_at, created_at';
+
+/** The user's notifications, newest first. */
+export async function fetchNotifications({ limit = 30 } = {}) {
+  if (!backendConfigured || !supabase) return [];
+  const { data, error } = await supabase
+    .from('notifications')
+    .select(COLUMNS)
+    .order('created_at', { ascending: false })
+    .limit(limit);
+  if (error) throw new Error(error.message);
+  return data ?? [];
+}
+
+/** Unread count for the bell badge (cheap: count-only query). */
+export async function fetchUnreadCount() {
+  if (!backendConfigured || !supabase) return 0;
+  const { count, error } = await supabase
+    .from('notifications')
+    .select('id', { count: 'exact', head: true })
+    .is('read_at', null);
+  if (error) throw new Error(error.message);
+  return count ?? 0;
+}
+
+/** Mark one notification as read. */
+export async function markNotificationRead(id) {
+  if (!backendConfigured || !supabase || !id) return;
+  const { error } = await supabase
+    .from('notifications')
+    .update({ read_at: new Date().toISOString() })
+    .eq('id', id);
+  if (error) throw new Error(error.message);
+}
+
+/** Mark every notification as read. */
+export async function markAllNotificationsRead() {
+  if (!backendConfigured || !supabase) return;
+  const { error } = await supabase
+    .from('notifications')
+    .update({ read_at: new Date().toISOString() })
+    .is('read_at', null);
+  if (error) throw new Error(error.message);
+}
diff --git a/src/lib/profileStats.js b/src/lib/profileStats.js
new file mode 100644
index 0000000..3c362d0
--- /dev/null
+++ b/src/lib/profileStats.js
@@ -0,0 +1,115 @@
+// Pure computations behind the profile experience: contribution tallies and
+// the GitHub-style activity calendar. No fetching, no React — everything
+// here is unit-testable (scripts/test-profile-stats.mjs) and shared by the
+// private profile (/account) and the public profile pages, so both always
+// agree on what the numbers mean.
+//
+// ACTIVITY RULE (one definition, used everywhere):
+//   A day's activity = the number of contributions the account SUBMITTED
+//   that day (created_at), regardless of current status. The calendar shows
+//   work done, not outcomes — accepted/declined/deleted are visible in the
+//   tallies instead. Entries with a missing created_at are ignored, never
+//   bucketed into a fake "today" (unknown is not zero, and it is not now).
+
+/** Tally contribution rows by status. Missing/unknown statuses are ignored. */
+export function tallyContributions(rows) {
+  const tally = { submitted: 0, accepted: 0, pending: 0, declined: 0, deleted: 0 };
+  for (const row of rows ?? []) {
+    tally.submitted += 1;
+    if (tally[row.status] !== undefined) tally[row.status] += 1;
+  }
+  return tally;
+}
+
+/** 'YYYY-MM-DD' for a Date, in LOCAL time (the calendar is local-first). */
+export const dayKey = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
+
+/**
+ * Group contribution rows into per-day counts. Accepts either rows with a
+ * `created_at`/`submitted_at` timestamp (own + public history shapes) or
+ * pre-counted { date, count } pairs. Invalid/missing timestamps are skipped.
+ */
+export function activityByDay(rows) {
+  const counts = new Map();
+  for (const row of rows ?? []) {
+    if (typeof row?.date === 'string' && Number.isFinite(row.count)) {
+      counts.set(row.date, (counts.get(row.date) ?? 0) + row.count);
+      continue;
+    }
+    const at = row?.created_at ?? row?.submitted_at ?? null;
+    if (!at) continue;
+    const date = new Date(at);
+    if (Number.isNaN(date.getTime())) continue;
+    const key = dayKey(date);
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  }
+  return counts;
+}
+
+/**
+ * Intensity level (0..4) for one day's count, given the month's maximum.
+ * GitHub-style quartiles: 0 stays 0 (no activity), otherwise the count is
+ * scaled against the busiest day of the visible month — an empty-but-active
+ * month still shows its busiest day at full intensity.
+ */
+export function activityLevel(count, maxInMonth) {
+  if (!count || count <= 0) return 0;
+  if (!maxInMonth || maxInMonth <= 0) return 1;
+  if (count >= maxInMonth) return 4;
+  const ratio = count / maxInMonth;
+  if (ratio > 0.5) return 3;
+  if (ratio > 0.25) return 2;
+  return 1;
+}
+
+/** First day (local midnight) of the month `offset` months from `today`. */
+export function monthAnchor(offset = 0, today = new Date()) {
+  return new Date(today.getFullYear(), today.getMonth() + offset, 1);
+}
+
+/** The number of months between two local months (a - b), for forward-limit math. */
+export function monthsAway(month, today = new Date()) {
+  return (month.getFullYear() - today.getFullYear()) * 12 + (month.getMonth() - today.getMonth());
+}
+
+/**
+ * The grid for one calendar month: weeks of 7 days, Monday-first (GitHub
+ * layout). Each cell: { key, date, inMonth, level, count } — out-of-month
+ * cells carry inMonth: false and are rendered as blanks. `maxInMonth` comes
+ * from activityByDay over the SAME month so levels are stable per view.
+ */
+export function monthGrid(month, activity, today = new Date()) {
+  const first = new Date(month.getFullYear(), month.getMonth(), 1);
+  // Shift Sunday (0) to the end for a Monday-first week.
+  const lead = (first.getDay() + 6) % 7;
+  const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
+  const keys = [...activity.keys()];
+  const maxInMonth = keys.reduce((max, key) => {
+    const d = new Date(`${key}T00:00:00`);
+    return d.getFullYear() === month.getFullYear() && d.getMonth() === month.getMonth()
+      ? Math.max(max, activity.get(key) ?? 0)
+      : max;
+  }, 0);
+
+  const cells = [];
+  for (let i = 0; i < lead; i += 1) cells.push(null);
+  for (let day = 1; day <= daysInMonth; day += 1) {
+    const date = new Date(month.getFullYear(), month.getMonth(), day);
+    const key = dayKey(date);
+    const count = activity.get(key) ?? 0;
+    cells.push({
+      key, date, inMonth: true,
+      count,
+      level: activityLevel(count, maxInMonth),
+      future: date > today,
+    });
+  }
+  // Pad the last week to a full 7 so the grid never has a ragged edge.
+  while (cells.length % 7 !== 0) cells.push(null);
+  const weeks = [];
+  for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
+  return weeks;
+}
+
+export const MONTH_LABELS = ['January', 'February', 'March', 'April', 'May', 'June',
+  'July', 'August', 'September', 'October', 'November', 'December'];
diff --git a/src/lib/profiles.js b/src/lib/profiles.js
new file mode 100644
index 0000000..d177903
--- /dev/null
+++ b/src/lib/profiles.js
@@ -0,0 +1,47 @@
+// Public profile access (the public_profiles view, migration 0004) plus the
+// per-username contribution history reused by the public profile page. Only
+// deliberately public fields ever cross this module: username, display name,
+// avatar, role, account creation date, and the public activity already
+// exposed by the public_log view. Tokens, Discord ids, ban state and every
+// other profile column stay in the database.
+
+import { supabase, backendConfigured } from './backend.js';
+
+/**
+ * Look up a public profile by username (case-insensitive: Discord usernames
+ * are lowercase, but the route must survive any casing someone types).
+ * Returns null when the backend is off or the profile is not public
+ * (unknown username, never-contributed member, or banned account).
+ */
+export async function fetchPublicProfile(username) {
+  if (!backendConfigured || !supabase || !username) return null;
+  const wanted = String(username).trim().toLowerCase();
+  if (!/^[a-z0-9._-]{1,32}$/.test(wanted)) return null; // not a username at all
+  const { data, error } = await supabase
+    .from('public_profiles')
+    .select('id, username, display_name, avatar_url, role, created_at')
+    .ilike('username', wanted)
+    .limit(2);
+  if (error) throw new Error(error.message);
+  // Exact (case-insensitive) match only — ilike allows wildcards we already
+  // screened out, but an exact compare is the honest guard.
+  const match = (data ?? []).find((row) => (row.username ?? '').toLowerCase() === wanted) ?? null;
+  return match;
+}
+
+/**
+ * One contributor's public contribution history (public_log view rows).
+ * Statuses, entry ids and dates are already public in the activity feed;
+ * payloads and review reasons never ride along.
+ */
+export async function fetchPublicContributions(username, { limit = 200 } = {}) {
+  if (!backendConfigured || !supabase || !username) return [];
+  const { data, error } = await supabase
+    .from('public_log')
+    .select('number, title, type, entry_id, entry_series, status, submitted_at, reviewed_at, contributor_name, contributor_username')
+    .eq('contributor_username', username)
+    .order('submitted_at', { ascending: false })
+    .limit(limit);
+  if (error) throw new Error(error.message);
+  return data ?? [];
+}
diff --git a/src/lib/statsCharts.js b/src/lib/statsCharts.js
new file mode 100644
index 0000000..86c8b24
--- /dev/null
+++ b/src/lib/statsCharts.js
@@ -0,0 +1,173 @@
+// Pure computations behind the statistics page. No fetching, no React — the
+// page feeds in the loaded catalogue (entries, characters, gadgets) and the
+// public activity rows, and gets back chart-ready series. Everything here is
+// unit-testable (scripts/test-profile-stats.mjs) and deliberately honest:
+//
+// DATA INTEGRITY RULES (do not "fix"):
+//   * "Documented" = the entry exists in the archive (an index record with
+//     a record file). The archive does not define an EXPECTED episode total,
+//     so no percentage of "all episodes ever" is invented — progress is
+//     completeness WITHIN the documented set.
+//   * "Fully documented" = every metadataChecklist item done (the same rule
+//     as the record status chips).
+//   * Segments are never counted as episodes: every count below is per
+//     ENTRY; a two-segment episode is one documented episode.
+//   * Character/gadget appearances: one entry counts one character once,
+//     even if the record lists it twice (dedup per entry). Missing refs are
+//     not zero — they are absent from the ranking entirely.
+//   * Community numbers come from public_log rows only; rows without the
+//     field needed for a chart are skipped, never counted as zero.
+
+/** Status tallies over a set of entries (see mergeEntry for `status`). */
+export function archiveCategoryStats(entries) {
+  const stats = { total: 0, episodes: 0, movies: 0, complete: 0, partial: 0, incomplete: 0, withSources: 0 };
+  for (const entry of entries ?? []) {
+    stats.total += 1;
+    if (entry.kind === 'movie') stats.movies += 1; else stats.episodes += 1;
+    if (entry.status === 'complete') stats.complete += 1;
+    else if (entry.status === 'partial') stats.partial += 1;
+    else stats.incomplete += 1;
+    if (entry.availability === 'available') stats.withSources += 1;
+  }
+  return stats;
+}
+
+/** Entries grouped by broadcast year ({year, count}), oldest first. */
+export function entriesByYear(entries) {
+  const counts = new Map();
+  for (const entry of entries ?? []) {
+    const year = entry.release?.date ? Number(String(entry.release.date).slice(0, 4)) : null;
+    if (!year || Number.isNaN(year)) continue; // unknown year is absent, not zero
+    counts.set(year, (counts.get(year) ?? 0) + 1);
+  }
+  return [...counts.entries()]
+    .sort((a, b) => a[0] - b[0])
+    .map(([year, count]) => ({ label: String(year), value: count }));
+}
+
+/** Histogram of segments per episode: one entry, one bucket. */
+export function segmentsHistogram(entries) {
+  const counts = new Map();
+  for (const entry of entries ?? []) {
+    if (entry.kind === 'movie') continue; // movies have no segments by shape
+    const n = Array.isArray(entry.segments) ? entry.segments.length : null;
+    if (!n || n < 1) continue; // unknown segment count is absent, not zero
+    const bucket = Math.min(n, 4);
+    const label = bucket === 4 ? '4+' : String(bucket);
+    counts.set(label, (counts.get(label) ?? 0) + 1);
+  }
+  return ['1', '2', '3', '4+']
+    .filter((label) => counts.has(label))
+    .map((label) => ({ label: `${label} segment${label === '1' ? '' : 's'}`, value: counts.get(label) }));
+}
+
+/** Histogram of distinct characters referenced per entry. */
+export function characterLoadHistogram(entries) {
+  const counts = new Map();
+  for (const entry of entries ?? []) {
+    const n = new Set(entry.characters ?? []).size;
+    if (!n) continue; // no documented characters: absent, not zero
+    const bucket = Math.min(n, 5);
+    const label = bucket === 5 ? '5+' : String(bucket);
+    counts.set(label, (counts.get(label) ?? 0) + 1);
+  }
+  return ['1', '2', '3', '4', '5+']
+    .filter((label) => counts.has(label))
+    .map((label) => ({ label: `${label} character${label === '1' ? '' : 's'}`, value: counts.get(label) }));
+}
+
+/**
+ * Appearance ranking over a set of entries. `records` is the catalog array
+ * ([{ id, name }]), `refKey` the entry field that references them
+ * ('characters' | 'gadgets') — passed in explicitly so this module stays
+ * importable outside the browser. Returns every record that is referenced
+ * at least once, most first; records never referenced are absent (a ranking
+ * of absent items would read as "zero appearances confirmed", which the
+ * archive does not claim).
+ */
+export function usageRanking(entries, records = [], refKey = 'characters') {
+  const catalog = records;
+  const kind = refKey;
+  const counts = new Map();
+  for (const entry of entries ?? []) {
+    const refs = new Set(entry[refKey] ?? []);
+    for (const id of refs) counts.set(id, (counts.get(id) ?? 0) + 1);
+  }
+  return catalog
+    .map((item) => ({
+      id: item.id,
+      name: item.name?.en ?? item.name?.ja ?? item.id,
+      value: counts.get(item.id) ?? 0,
+    }))
+    .filter((row) => row.value > 0)
+    .sort((a, b) => b.value - a.value || a.name.localeCompare(b.name));
+}
+
+/**
+ * Most common character pairings: the top co-appearances across entries.
+ * Each entry votes once per pair it references. `characters` is the catalog
+ * array, passed in explicitly (see usageRanking).
+ */
+export function characterCombos(entries, characters = [], { limit = 6 } = {}) {
+  const catalog = characters;
+  const names = new Map(catalog.map((c) => [c.id, c.name?.en ?? c.name?.ja ?? c.id]));
+  const counts = new Map();
+  for (const entry of entries ?? []) {
+    const refs = [...new Set(entry.characters ?? [])].sort();
+    for (let i = 0; i < refs.length; i += 1) {
+      for (let j = i + 1; j < refs.length; j += 1) {
+        const key = `${refs[i]}+${refs[j]}`;
+        counts.set(key, (counts.get(key) ?? 0) + 1);
+      }
+    }
+  }
+  return [...counts.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, limit)
+    .map(([key, value]) => {
+      const [a, b] = key.split('+');
+      return { id: key, label: `${names.get(a) ?? a} + ${names.get(b) ?? b}`, value };
+    });
+}
+
+/** Community tallies from public_log rows (public activity feed shape). */
+export function communityStats(rows) {
+  const byStatus = { submitted: 0, accepted: 0, pending: 0, declined: 0, deleted: 0 };
+  const bySeries = new Map();
+  const byContributor = new Map();
+  for (const row of rows ?? []) {
+    byStatus.submitted += 1;
+    if (byStatus[row.status] !== undefined) byStatus[row.status] += 1;
+    if (row.entry_series) bySeries.set(row.entry_series, (bySeries.get(row.entry_series) ?? 0) + 1);
+    if (row.status === 'accepted' && row.contributor_username) {
+      const agg = byContributor.get(row.contributor_username) ?? { username: row.contributor_username, name: row.contributor_name, value: 0 };
+      agg.value += 1;
+      byContributor.set(row.contributor_username, agg);
+    }
+  }
+  return {
+    byStatus,
+    bySeries: [...bySeries.entries()].map(([series, count]) => ({ series, count })),
+    topContributors: [...byContributor.values()].sort((a, b) => b.value - a.value).slice(0, 8),
+  };
+}
+
+/** Submissions per month for the last `months` months, oldest first. */
+export function monthlyActivity(rows, { months = 12, today = new Date() } = {}) {
+  const buckets = [];
+  for (let i = months - 1; i >= 0; i -= 1) {
+    const d = new Date(today.getFullYear(), today.getMonth() - i, 1);
+    buckets.push({ key: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`, label: d.toLocaleDateString(undefined, { month: 'short', year: '2-digit' }), value: 0 });
+  }
+  const index = new Map(buckets.map((b, i) => [b.key, i]));
+  for (const row of rows ?? []) {
+    const at = row?.submitted_at;
+    if (!at) continue;
+    const d = new Date(at);
+    if (Number.isNaN(d.getTime())) continue;
+    const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
+    const i = index.get(key);
+    if (i !== undefined) buckets[i].value += 1;
+  }
+  return buckets;
+}
