+  font-family: var(--mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em;
+  color: var(--text-3);
+}
+.ev-coverage {
+  color: var(--accent); font-size: 0.72rem;
+  display: inline-flex; align-items: center; gap: 5px;
+}
+.source-row__side { margin-left: auto; display: flex; align-items: center; gap: var(--s-2); }
+.source-row__external {
+  appearance: none; background: none; cursor: pointer;
+  border: 1px solid var(--border); border-radius: var(--r-sm);
+  color: var(--text-3); padding: 4px 6px;
+  transition: color 0.15s, border-color 0.15s;
+}
+.source-row__external:hover { color: var(--accent); border-color: var(--accent); }
+.source-row__meta { margin: 0; color: var(--text-2); font-size: 0.86rem; }
+.source-row__note { font-size: 0.82rem; }
+.source-row__player { display: grid; gap: var(--s-2); animation: ev-fade 0.2s var(--ease) both; }
+.ev-no-source { justify-items: start; padding: var(--s-4); }
+
+/* ---------- 10 · Voice cast ---------- */
+#voice-cast .data-table a { color: var(--text); }
+#voice-cast .data-table a:hover { color: var(--accent); }
+
+/* ---------- Classic view (legacy episode page) ---------- */
+.segment-tabs {
+  display: flex; flex-wrap: wrap; gap: var(--s-2);
+  padding: var(--s-2) 0; border-block: 1px solid var(--border);
+}
+.segment-tabs__tab {
+  appearance: none; cursor: pointer; font: inherit; font-size: 0.85rem;
+  padding: 5px 12px; border-radius: 999px;
+  border: 1px solid var(--border); background: var(--surface); color: var(--text-2);
+  transition: color 0.15s, border-color 0.15s, background 0.15s;
+}
+.segment-tabs__tab:hover { color: var(--text); border-color: var(--border-strong); }
