--- /dev/null
+++ b/src/styles/community.css
@@ -0,0 +1,263 @@
+/* Community & profile features: notifications bell + panel, role badges,
+   profile headers, the contribution calendar, entry attribution, and the
+   statistics page's charts. Every colour is a theme token, so built-in and
+   custom themes stay legible; motion respects prefers-reduced-motion and
+   the studio's motion setting (both checked per block). */
+
+/* ---------- role badges ---------- */
+.role-badge {
+  display: inline-flex; align-items: center;
+  font-size: 0.7rem; font-weight: 600; line-height: 1;
+  text-transform: uppercase; letter-spacing: 0.06em;
+  padding: 3px 8px; border-radius: 999px;
+  border: 1px solid var(--border-strong);
+  color: var(--text-2); background: var(--surface-2);
+  vertical-align: middle;
+}
+.role-badge--owner {
+  color: var(--accent); border-color: color-mix(in srgb, var(--accent) 55%, transparent);
+  background: color-mix(in srgb, var(--accent) 12%, transparent);
+}
+.role-badge--admin { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); background: color-mix(in srgb, var(--ok) 10%, transparent); }
+.role-badge--checker { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, transparent); background: color-mix(in srgb, var(--warn) 10%, transparent); }
+.role-badge--sm { font-size: 0.62rem; padding: 2px 7px; }
+
+/* ---------- notifications ---------- */
+.notifications { position: relative; }
+.notifications__badge {
+  position: absolute; top: -3px; right: -3px; z-index: 2;
+  min-width: 17px; height: 17px; padding: 0 4px;
+  display: grid; place-items: center;
+  border-radius: 999px; background: var(--bad); color: #fff;
+  font-size: 0.62rem; font-weight: 700; line-height: 1;
+  font-family: var(--mono);
+  border: 2px solid var(--bg);
+}
+.notifications__panel {
+  position: absolute; top: calc(100% + 10px); right: 0; z-index: 60;
+  width: min(390px, calc(100vw - 32px));
+  background: var(--surface); border: 1px solid var(--border-strong);
+  border-radius: var(--r-md); box-shadow: var(--shadow-soft);
+  padding: var(--s-2) 0 0;
+  animation: panel-in 0.16s var(--ease) both;
+}
+.notifications__head {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: 0 var(--s-4) var(--s-2);
+}
+.notifications__loading, .notifications__empty, .notifications__error {
+  margin: 0; padding: var(--s-2) var(--s-4) var(--s-4);
+}
+.notifications__list { max-height: min(420px, 60vh); overflow-y: auto; border-top: 1px solid var(--border); }
+.notifications-item {
+  display: flex; align-items: flex-start; gap: 10px; width: 100%;
+  appearance: none; background: none; border: 0; cursor: pointer;
+  font: inherit; color: var(--text); text-align: left;
+  padding: var(--s-3) var(--s-4);
+}
+.notifications-item + .notifications-item { border-top: 1px solid var(--border); }
+.notifications-item:hover { background: var(--surface-2); }
+.notifications-item__icon {
+  flex: none; width: 24px; height: 24px; display: grid; place-items: center;
+  border-radius: 999px; margin-top: 1px;
+  border: 1px solid transparent;
+}
+.notifications-item.is-accepted .notifications-item__icon { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
+.notifications-item.is-declined .notifications-item__icon { color: var(--bad); background: color-mix(in srgb, var(--bad) 12%, transparent); border-color: color-mix(in srgb, var(--bad) 40%, transparent); }
+.notifications-item.is-deleted .notifications-item__icon { color: var(--bad); background: color-mix(in srgb, var(--bad) 12%, transparent); border-color: color-mix(in srgb, var(--bad) 40%, transparent); }
+.notifications-item__body { flex: 1; min-width: 0; display: grid; gap: 3px; }
+.notifications-item__text { font-size: 0.86rem; line-height: 1.45; }
+.notifications-item__go { color: var(--accent); }
+.notifications-item__meta { font-family: var(--mono); font-size: 0.72rem; color: var(--text-3); }
+.notifications-item__dot {
+  flex: none; width: 8px; height: 8px; margin-top: 8px;
+  border-radius: 999px; background: var(--accent);
+}
+.notifications-item { --fade: 0.55; }
+.notifications-item.is-unread { --fade: 0; }
+.notifications-item .notifications-item__icon { opacity: calc(1 - var(--fade) * 0.5); }
+
+/* ---------- profile headers ---------- */
+.profile-header {
+  display: flex; gap: var(--s-4); align-items: flex-start;
+  padding: var(--s-4) 0 var(--s-5);
+  border-bottom: 1px solid var(--border);
+  margin-bottom: var(--s-5);
+}
+.profile-header__main { display: grid; gap: 4px; min-width: 0; }
+.profile-header__name {
+  display: inline-flex; align-items: center; gap: var(--s-2); flex-wrap: wrap;
+  margin: 0; font-size: clamp(1.5rem, 3.2vw, 2rem);
+}
+.profile-header__handle { margin: 0; color: var(--accent); font-size: 0.92rem; }
+.profile-header__meta { display: inline-flex; align-items: center; gap: 6px; margin: 0; font-size: 0.84rem; }
+.profile-header__meta .icon { color: var(--text-3); }
+.profile-header__url { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; margin-top: var(--s-1); }
+.profile-header__url a.mono { font-size: 0.82rem; color: var(--text-2); text-decoration: none; }
+.profile-header__url a.mono:hover { color: var(--accent); text-decoration: underline; }
+.btn.is-copied { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
+.profile-stats { margin-bottom: var(--s-5); }
+.profile-stat--accepted .stat-card__value { color: var(--ok); }
+.profile-stat--pending .stat-card__value { color: var(--warn); }
+.profile-stat--declined .stat-card__value { color: var(--bad); }
+.profile-footer-note { margin-top: var(--s-5); }
+
+/* ---------- contribution calendar ---------- */
+.contrib-calendar {
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  background: var(--surface); padding: var(--s-4) var(--s-4) var(--s-3);
+  display: grid; gap: var(--s-3);
+  /* One month of squares reads best at GitHub-ish proportions; a wide
+     container would balloon the squares instead. */
+  max-width: 660px;
+}
+.contrib-calendar__head { display: flex; align-items: center; gap: var(--s-2); }
+.contrib-calendar__month { min-width: 150px; text-align: center; font-size: 0.95rem; }
+.contrib-calendar__total { margin-left: auto; }
+.contrib-calendar__grid {
+  display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;
+}
+.contrib-calendar__weekday {
+  font-family: var(--mono); font-size: 0.64rem; text-transform: uppercase;
+  letter-spacing: 0.08em; color: var(--text-3);
+  text-align: center; padding-bottom: 2px;
+}
+.contrib-calendar__cell {
+  width: 100%; aspect-ratio: 1; border-radius: 4px;
+  background: var(--surface-3);
+  border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
+}
+.contrib-calendar__cell.is-future { opacity: 0.35; }
+.contrib-calendar__cell.is-l1 { background: color-mix(in srgb, var(--accent) 30%, var(--surface-3)); border-color: transparent; }
+.contrib-calendar__cell.is-l2 { background: color-mix(in srgb, var(--accent) 55%, var(--surface-3)); border-color: transparent; }
+.contrib-calendar__cell.is-l3 { background: color-mix(in srgb, var(--accent) 80%, var(--surface-3)); border-color: transparent; }
+.contrib-calendar__cell.is-l4 { background: var(--accent); border-color: transparent; }
+.contrib-calendar__cell.is-l4 { box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent) inset; }
+.contrib-calendar__legend { display: inline-flex; align-items: center; gap: 4px; justify-self: end; }
+.contrib-calendar__legend .contrib-calendar__cell { width: 12px; aspect-ratio: 1; }
+
+/* ---------- entry attribution ---------- */
+.attribution {
+  display: flex; align-items: flex-start; gap: 10px;
+  padding: var(--s-3) var(--s-4);
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  background: var(--surface);
+}
+.attribution__icon { flex: none; margin-top: 2px; }
+.attribution__facts { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
+.attribution__fact { font-size: 0.88rem; color: var(--text-2); }
+.attribution__who {
+  display: inline-flex; align-items: center; gap: 7px; font-weight: 500;
+  color: var(--text); text-decoration: none;
+}
+a.attribution__who:hover { color: var(--accent); }
+
+/* ---------- statistics: progress + charts ---------- */
+.stats-progress {
+  display: grid; grid-template-columns: 1.4fr 0.6fr; gap: var(--s-5);
+  padding: var(--s-5); margin-bottom: var(--s-6);
+  border: 1px solid var(--border); border-radius: var(--r-lg);
+  background: var(--surface);
+}
+.stats-progress__main { display: grid; gap: var(--s-2); align-content: start; }
+.stats-progress__main h2 { margin: 0; }
+.stats-progress__count { margin: 0; font-size: 1.05rem; color: var(--text-2); }
+.stats-progress__number { font-size: 1.9rem; font-weight: 700; color: var(--text); margin-right: 6px; }
+.stats-progress__bar {
+  height: 12px; border-radius: 999px; overflow: hidden;
+  background: var(--surface-3); border: 1px solid var(--border);
+}
+.stats-progress__bar span {
+  display: block; height: 100%; border-radius: inherit;
+  background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 75%, transparent), var(--accent));
+  transition: width 0.7s var(--ease);
+}
+.stats-progress__pct { margin: 0; }
+.stats-progress__facts { display: grid; gap: var(--s-2); align-content: start; margin: 0; }
+.stats-progress__facts > div {
+  display: grid; gap: 2px; padding: var(--s-2) var(--s-3);
+  border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface-2);
+}
+.stats-progress__facts dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); font-family: var(--mono); }
+.stats-progress__facts dd { margin: 0; font-size: 1.15rem; }
+
+.chart-grid {
+  display: grid; grid-template-columns: repeat(auto-fit, minmax(min(430px, 100%), 1fr));
+  gap: var(--s-4); margin-bottom: var(--s-5);
+}
+.chart-card {
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  background: var(--surface); padding: var(--s-4) var(--s-4) var(--s-3);
+  display: grid; gap: var(--s-3); align-content: start;
+}
+.chart-card__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); }
+.chart-card__head h3 { margin: 0; font-size: 1.02rem; }
+.chart-card__note { margin: 0; }
+
+/* donut */
+.donut { display: grid; gap: var(--s-3); justify-items: center; }
+.donut svg { max-width: 100%; height: auto; display: block; }
+.donut__track { stroke: var(--surface-3); }
+.donut__slice { transition: stroke-dasharray 0.7s var(--ease), stroke-dashoffset 0.7s var(--ease); }
+.donut__center { display: grid; justify-items: center; margin-top: calc(-1 * (180px * 0.32)); margin-bottom: calc(-1 * (180px * 0.08)); pointer-events: none; }
+.donut__value { font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
+.donut__label { font-size: 0.78rem; color: var(--text-3); }
+.donut__legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px 18px; grid-template-columns: repeat(auto-fit, minmax(140px, auto)); width: 100%; }
+.donut__legend li { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.donut__swatch { flex: none; width: 10px; height: 10px; border-radius: 3px; border: 1px solid var(--border); }
+.donut__legend-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.84rem; color: var(--text-2); }
+.donut__legend-value { color: var(--text); font-size: 0.82rem; }
+
+/* bar chart */
+.barchart { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
+.barchart__link {
+  display: grid; grid-template-columns: minmax(90px, 170px) 1fr auto;
+  align-items: center; gap: var(--s-3);
+  color: inherit; text-decoration: none; min-width: 0;
+}
+.barchart__label {
+  font-size: 0.84rem; color: var(--text-2);
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+a.barchart__link:hover .barchart__label { color: var(--accent); }
+.barchart__track { height: 14px; border-radius: 5px; background: var(--surface-3); overflow: hidden; border: 1px solid color-mix(in srgb, var(--border) 55%, transparent); }
+.barchart__fill { display: block; height: 100%; border-radius: inherit; background: color-mix(in srgb, var(--accent) 78%, transparent); transition: width 0.65s var(--ease); }
+.barchart__fill.is-highlight { background: var(--accent); }
+.barchart__value { font-size: 0.8rem; color: var(--text-2); min-width: 2ch; text-align: right; }
+.chart-empty { margin: var(--s-2) 0; }
+
+.stats-footnote { display: flex; gap: 8px; align-items: flex-start; max-width: 78ch; }
+.stats-footnote .icon { color: var(--text-3); flex: none; margin-top: 2px; }
+
+/* ---------- motion preferences ---------- */
+/* The studio's motion setting and the OS preference both turn chart and
+   panel animations off; the calendar and progress bars are static shapes
+   and need no rule. */
+@media (prefers-reduced-motion: reduce) {
+  .donut__slice, .barchart__fill, .stats-progress__bar span, .notifications__panel { transition: none; animation: none; }
+}
+:root[data-motion='none'] .donut__slice,
+:root[data-motion='none'] .barchart__fill,
+:root[data-motion='none'] .stats-progress__bar span,
+:root[data-motion='none'] .notifications__panel { transition: none; animation: none; }
+:root[data-motion='subtle'] .donut__slice,
+:root[data-motion='subtle'] .barchart__fill,
+:root[data-motion='subtle'] .stats-progress__bar span { transition-duration: 0.25s; }
+
+/* ---------- responsive ---------- */
+@media (max-width: 860px) {
+  .stats-progress { grid-template-columns: 1fr; gap: var(--s-4); }
+  .profile-header { flex-direction: column; gap: var(--s-3); }
+}
+@media (max-width: 560px) {
+  .contrib-calendar__grid { gap: 3px; }
+  .contrib-calendar__weekday { font-size: 0.56rem; }
+  .contrib-calendar { padding: var(--s-3); }
+  /* The month title and the per-month total wrap instead of pushing the
+     row past the viewport edge. */
+  .contrib-calendar__head { flex-wrap: wrap; }
+  .contrib-calendar__month { flex: 1; min-width: 0; }
+  .contrib-calendar__total { flex-basis: 100%; margin-left: 0; }
+  .barchart__link { grid-template-columns: minmax(76px, 120px) 1fr auto; }
+  .notifications__panel { right: -44px; }
+}
