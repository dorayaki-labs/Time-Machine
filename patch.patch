+/* ---------------------------------------------------------------------------
+   Episode view V2 + the classic view's segment tabs.
+   All colors, spacing and radii come from the theme tokens (variables.css),
+   so both themes and custom themes style this page automatically.
+   ------------------------------------------------------------------------- */
+
+/* Section vocabulary shared by every episode section: a small uppercase
+   mono heading with an accent tick — the "professional archive" voice. */
+.ev-section { display: grid; gap: var(--s-3); }
+h2.ev-section-title {
+  margin: 0;
+  display: inline-flex; align-items: center; gap: 10px;
+  font-family: var(--mono); font-size: 0.8rem; font-weight: 500;
+  text-transform: uppercase; letter-spacing: 0.12em;
+  color: var(--text-2);
+}
+h2.ev-section-title::before {
+  content: ''; width: 18px; height: 2px; flex: none;
+  background: var(--accent); border-radius: 999px;
+}
+.ev-subhead {
+  margin: 0; font-size: 0.95rem; font-weight: 600; color: var(--text);
+}
+.ev-subhead--gap { margin-top: var(--s-4); }
+.ev-subhead .muted { font-family: var(--mono); font-size: 0.78rem; font-weight: 400; }
+
+.ev-anim { animation: ev-fade 0.22s var(--ease) both; }
+@keyframes ev-fade { from { opacity: 0; transform: translatey(6px); } to { opacity: 1; transform: none; } }
+@media (prefers-reduced-motion: reduce) {
+  .ev-anim { animation: none; }
+}
+
+.ev-missing {
+  margin: 0; display: inline-flex; align-items: center; gap: 7px;
+  color: var(--text-3); font-size: 0.88rem;
+  padding: 6px 10px; border: 1px dashed var(--border); border-radius: var(--r-sm);
+  background: var(--surface-2); width: fit-content; max-width: 100%;
+}
+
+/* ---------- 01 · Episode header ---------- */
+.ev-header {
+  display: grid; grid-template-columns: minmax(280px, 460px) minmax(0, 1fr);
+  gap: var(--s-6); align-items: start;
+}
+.ev-header__media {
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  overflow: hidden; background: var(--surface-2);
+}
+.ev-header__media .media { width: 100%; aspect-ratio: 16 / 9; }
+.ev-header__media .media__img,
+.ev-header__media .media__placeholder {
+  width: 100%; height: 100%; object-fit: contain; display: block;
+}
+.ev-header__body { display: grid; gap: var(--s-3); min-width: 0; align-content: start; }
+.ev-header__body .eyebrow {
+  display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; margin: 0;
+}
+.ev-pill { font-size: 0.7rem; white-space: nowrap; }
+.ev-header__title {
+  margin: 0; font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1.22;
+  overflow-wrap: anywhere;
+}
+.ev-header__combined {
+  margin: calc(var(--s-1) * -1) 0 0; font-size: 0.92rem;
+  overflow-wrap: anywhere;
+}
+
+/* The compact metadata table: label column fixed, subtle row separators. */
+.ev-facts { border-top: 1px solid var(--border); }
+.ev-facts > div {
+  grid-template-columns: minmax(120px, 150px) minmax(0, 1fr);
+  gap: var(--s-3); padding: var(--s-2) 0;
+}
+.ev-facts dt { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; padding-top: 2px; }
+.ev-facts dd { font-size: 0.92rem; overflow-wrap: anywhere; }
+
+.ev-copy { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
+.ev-copy__btn {
+  appearance: none; background: none; cursor: pointer;
+  display: inline-flex; align-items: center; gap: 4px;
+  border: 1px solid var(--border); border-radius: var(--r-sm);
+  color: var(--text-3); padding: 2px 7px; font: inherit; font-size: 0.75rem;
+  transition: color 0.15s, border-color 0.15s, background 0.15s;
+}
+.ev-copy__btn:hover { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
+.ev-copy__done { color: var(--ok); font-size: 0.72rem; font-family: var(--mono); }
+
+/* ---------- 02 · Archive completeness ---------- */
+.ev-completeness { display: grid; gap: var(--s-3); }
+.ev-completeness__figure { font-size: 0.8rem; color: var(--text-2); }
+.ev-completeness__bar { height: 8px; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
+.ev-completeness__bar span { display: block; height: 100%; border-radius: inherit; background: var(--accent); transition: width 0.3s var(--ease); }
+.ev-completeness__groups { display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
+.ev-completeness__group { display: grid; gap: var(--s-2); align-content: start; }
+.ev-completeness__label {
+  margin: 0; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em;
+  color: var(--text-3);
+}
+.ev-completeness__chips { display: flex; flex-wrap: wrap; gap: 6px; }
+
+.ev-field {
+  appearance: none; cursor: pointer;
+  display: inline-flex; align-items: center; gap: 6px;
+  font: inherit; font-size: 0.78rem;
+  padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border);
+  background: var(--surface); color: var(--text-2);
+  transition: border-color 0.15s, color 0.15s, background 0.15s;
+}
+.ev-field:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+.ev-field__dot { width: 7px; height: 7px; border-radius: 999px; flex: none; background: var(--text-3); }
+.ev-field svg { flex: none; opacity: 0.8; }
+.ev-field.is-done { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 35%, transparent); }
+.ev-field.is-done .ev-field__dot { background: var(--ok); }
+.ev-field.is-partial { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
+.ev-field.is-partial .ev-field__dot { background: var(--warn); }
+.ev-field.is-missing { color: var(--text-3); }
+.ev-field:hover { border-color: var(--accent-line); background: var(--accent-soft); color: var(--text); }
+
+/* ---------- 03 · Segment selector ---------- */
+.ev-segments { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--s-3); }
+.ev-seg-card {
+  position: relative;
+  appearance: none; cursor: pointer; text-align: left; font: inherit;
+  display: grid; gap: 6px; align-content: start; padding: var(--s-3) var(--s-3);
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  background: var(--surface); color: var(--text); min-width: 0;
+  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
+}
+.ev-seg-card:hover { border-color: var(--accent-line); background: var(--surface-2); }
+.ev-seg-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.ev-seg-card.is-active {
+  border-color: var(--accent); background: var(--accent-soft);
+  box-shadow: 0 0 0 1px var(--accent) inset;
+}
+.ev-seg-card__top {
+  display: flex; align-items: center; justify-content: space-between; gap: var(--s-2);
+  font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3);
+}
+.ev-seg-card.is-active .ev-seg-card__top { color: var(--accent); }
+.ev-seg-card__duration { flex: none; }
+.ev-seg-card__title {
+  font-weight: 600; font-size: 0.95rem; line-height: 1.3; min-width: 0;
+  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
+  overflow: hidden; overflow-wrap: anywhere;
+}
+.ev-seg-card__doc {
+  display: inline-flex; align-items: center; gap: 6px;
+  font-size: 0.72rem; font-family: var(--mono); color: var(--text-3);
+}
+.ev-seg-card__dot { width: 8px; height: 8px; border-radius: 999px; flex: none; background: var(--text-3); }
+.ev-seg-card__dot--full { background: var(--ok); }
+.ev-seg-card__dot--partial { background: var(--warn); }
+
+/* ---------- 04 · Archive actions ---------- */
+.ev-actions {
+  display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2);
+  padding-top: var(--s-3); border-top: 1px solid var(--border);
+}
+.ev-actions__classic { margin-left: auto; }
+
+/* ---------- 05 · Recent contributions timeline ---------- */
+.ev-timeline-section { max-width: 640px; }
+.ev-viewall {
+  appearance: none; background: none; border: 0; cursor: pointer;
+  display: inline-flex; align-items: center; gap: 5px;
+  font: inherit; font-size: 0.82rem; color: var(--accent);
+  padding: 2px 4px; border-radius: var(--r-sm);
+}
+.ev-viewall:hover { text-decoration: underline; }
+.ev-timeline {
+  list-style: none; margin: 0; padding: 0; position: relative;
+  display: grid; gap: 0;
+}
+.ev-timeline__item {
+  position: relative; display: flex; align-items: flex-start; gap: var(--s-3);
+  padding: var(--s-3) 0 var(--s-3) var(--s-2);
+}
+.ev-timeline__item:not(:last-child)::before {
+  content: ''; position: absolute; left: 5px; top: 30px; bottom: -6px;
+  width: 2px; background: var(--border);
+}
+.ev-timeline__dot {
+  position: absolute; left: 0; top: 16px;
+  width: 12px; height: 12px; border-radius: 999px;
+  background: var(--text-3); border: 2px solid var(--surface); flex: none;
+}
+.ev-timeline__item--ok .ev-timeline__dot { background: var(--ok); }
+.ev-timeline__item--bad .ev-timeline__dot { background: var(--bad); }
+.ev-timeline__item--pending .ev-timeline__dot { background: var(--warn); }
+.ev-timeline__item--review .ev-timeline__dot { background: var(--review, var(--accent)); }
+.ev-timeline__item .avatar { flex: none; margin-left: var(--s-3); }
+.ev-timeline__body { min-width: 0; padding-top: 2px; }
+.ev-timeline__line { margin: 0; font-size: 0.92rem; overflow-wrap: anywhere; }
+.ev-timeline__meta { margin: 2px 0 0; }
+
+/* ---------- 06 · About this segment ---------- */
+.ev-about { display: grid; gap: var(--s-2); max-width: 72ch; }
+.ev-about__summary { margin: 0; font-size: 1rem; }
+.ev-about__synopsis { margin: 0; }
+.ev-about__synopsis p { margin: 0; line-height: 1.75; overflow-wrap: anywhere; }
+.ev-about__synopsis.is-clamped {
+  max-height: 15.5em; overflow: hidden; position: relative;
+}
+.ev-about__synopsis.is-clamped::after {
+  content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 5.5em;
+  background: linear-gradient(to bottom, transparent, var(--bg));
+  pointer-events: none;
+}
+.ev-about__more { justify-self: start; }
+.ev-alt-titles { margin: 0; }
+
+/* ---------- 07 · Screenshot carousel ---------- */
+.shot-carousel { display: grid; gap: var(--s-3); }
+.shot-carousel__row {
+  display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
+  gap: var(--s-2); align-items: center; justify-items: center;
+}
+.shot-carousel__nav { flex: none; }
+.shot-carousel__stage {
+  margin: 0; width: 100%; max-width: 760px;
+}
+.shot-carousel__frame {
+  appearance: none; background: none; border: 0; cursor: zoom-in; padding: 0;
+  position: relative; display: block; width: 100%;
+  aspect-ratio: 16 / 9; max-height: 440px;
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  background: var(--surface-2); overflow: hidden;
+}
+.shot-carousel__frame img {
+  width: 100%; height: 100%; object-fit: contain; display: block;
+  animation: ev-fade 0.18s var(--ease) both;
+}
+@media (prefers-reduced-motion: reduce) {
+  .shot-carousel__frame img { animation: none; }
+}
+.shot-carousel__counter {
+  position: absolute; top: 10px; right: 10px;
+  font-size: 0.72rem; color: var(--text);
+  background: color-mix(in srgb, var(--bg) 80%, transparent);
+  border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px;
+}
+.shot-carousel__zoom {
+  position: absolute; bottom: 10px; right: 10px;
+  display: inline-flex; align-items: center; gap: 5px;
+  font-size: 0.68rem; color: var(--text-2);
+  background: color-mix(in srgb, var(--bg) 80%, transparent);
+  border: 1px solid var(--border); border-radius: 999px; padding: 2px 8px;
+  opacity: 0; transition: opacity 0.15s;
+}
+.shot-carousel__frame:hover .shot-carousel__zoom,
+.shot-carousel__frame:focus-visible .shot-carousel__zoom { opacity: 1; }
+
+.shot-carousel__strip {
+  display: flex; gap: 8px; overflow-x: auto; padding: 2px;
+  scrollbar-width: thin;
+}
+.shot-carousel__thumb {
+  appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
+  flex: none; width: 92px; aspect-ratio: 16 / 9;
+  border-radius: var(--r-sm); overflow: hidden;
+  border: 2px solid var(--border); opacity: 0.65;
+  transition: border-color 0.15s, opacity 0.15s;
+}
+.shot-carousel__thumb:hover { opacity: 1; }
+.shot-carousel__thumb.is-active { border-color: var(--accent); opacity: 1; }
+.shot-carousel__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.shot-carousel__thumb:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.lightbox__counter {
+  position: absolute; top: var(--s-4); left: var(--s-4);
+  font-size: 0.78rem; color: var(--text-2);
+  background: color-mix(in srgb, var(--bg) 75%, transparent);
+  border: 1px solid var(--border); border-radius: 999px; padding: 3px 10px;
+}
+
+/* ---------- 08 · Viewing sources ---------- */
+.ev-sources { display: grid; gap: var(--s-3); }
+.ev-sources__hint { margin: 0; }
+.ev-sources__list { display: grid; gap: var(--s-2); }
+.source-row {
+  border: 1px solid var(--border); border-radius: var(--r-md);
+  background: var(--surface); padding: var(--s-3) var(--s-4);
+  display: grid; gap: var(--s-2);
+  transition: border-color 0.15s, background 0.15s;
+}
+.source-row:hover { border-color: var(--accent-line); }
+.source-row.is-active { border-color: var(--accent); background: var(--accent-soft); }
+.source-row__head {
+  display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap;
+}
+.source-row__id { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; min-width: 0; }
+.source-row__provider { font-weight: 600; font-size: 0.98rem; }
