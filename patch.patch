+  .ev-segments::-webkit-scrollbar { display: none; }
+  .ev-seg-card { scroll-snap-align: start; }
+  .ev-completeness__groups { grid-template-columns: 1fr; }
+  .ev-facts > div { grid-template-columns: minmax(104px, 130px) minmax(0, 1fr); }
+  .source-row__side { margin-left: 0; width: 100%; justify-content: flex-end; }
+}
+
+@media (max-width: 600px) {
+  .ev-header__title { font-size: 1.3rem; }
+  .ev-facts > div { grid-template-columns: minmax(96px, 110px) minmax(0, 1fr); gap: var(--s-2); font-size: 0.9rem; }
+  .shot-carousel__row { grid-template-columns: auto minmax(0, 1fr) auto; gap: 6px; }
+  .shot-carousel__frame { aspect-ratio: 16 / 10; }
+  .shot-carousel__thumb { width: 72px; }
+  .ev-actions { gap: var(--s-2); }
+  .ev-actions .btn { flex: 1 1 auto; justify-content: center; }
+  .ev-actions__classic { margin-left: 0; flex-basis: 100%; }
+  .ev-timeline-section { max-width: none; }
+  .lightbox__counter { top: var(--s-2); left: var(--s-2); }
+}
