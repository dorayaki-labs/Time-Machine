 import { buildEmbed, sanitize } from '../supabase/functions/_shared/discord.js';
 import { checkRoleAction, canReviewContribution } from '../supabase/functions/_shared/rbac.js';
 import { applyArchivePatch, resolvePaths } from '../supabase/functions/_shared/patch.js';
+import { preflight, withCors, json } from '../supabase/functions/_shared/cors.js';
 
 let passed = 0;
 const pending = [];
@@ -238,5 +239,54 @@ test('character update edits the array file by id', async () => {
   assert.deepEqual(res.changes, [{ field: 'description', before: null, after: 'Protagonist.' }]);
 });
 
+// CORS: the browser needs the allow-origin header on the preflight AND on the
+// actual POST response; missing either shows up in the UI as NetworkError.
+const env = { get: (k) => (k === 'ALLOWED_ORIGINS' ? 'https://karizzmaa.github.io/' : '') };
+
+test('origin matching tolerates trailing slash and case in the secret', () => {
+  const req = new Request('https://x/functions/v1/contribute', { method: 'OPTIONS', headers: { Origin: 'https://karizzmaa.github.io' } });
+  const res = preflight(req, env);
+  assert.equal(res.status, 204);
+  assert.equal(res.headers.get('Access-Control-Allow-Origin'), 'https://karizzmaa.github.io');
+  const req2 = new Request('https://x/functions/v1/contribute', { method: 'OPTIONS', headers: { Origin: 'https://KARIZZMAA.github.io' } });
+  assert.equal(preflight(req2, env).status, 204);
+  const bad = new Request('https://x/functions/v1/contribute', { method: 'OPTIONS', headers: { Origin: 'https://evil.example' } });
+  assert.equal(preflight(bad, env).status, 403);
+});
+
+test('a "*" entry in ALLOWED_ORIGINS allows every origin', () => {
+  const star = { get: (k) => (k === 'ALLOWED_ORIGINS' ? '*' : '') };
+  const req = new Request('https://x/functions/v1/contribute', { method: 'OPTIONS', headers: { Origin: 'https://anything.example' } });
+  assert.equal(preflight(req, star).status, 204);
+});
+
+test('withCors stamps the actual POST response for allowed origins', async () => {
+  const req = new Request('https://x/functions/v1/contribute', {
+    method: 'POST', headers: { Origin: 'https://karizzmaa.github.io', 'Content-Type': 'application/json' },
+  });
+  const wrapped = await Promise.resolve(json({ ok: true, number: 7 }, 200)).then((r) => withCors(r, req, env));
+  assert.equal(wrapped.status, 200);
+  assert.equal(wrapped.headers.get('Access-Control-Allow-Origin'), 'https://karizzmaa.github.io');
+  assert.equal(wrapped.headers.get('Vary'), 'Origin');
+  assert.deepEqual(await wrapped.json(), { ok: true, number: 7 });
+
+  // A preflight-style response that already carries the header must not get it twice.
+  const pre = preflight(new Request('https://x/', { method: 'OPTIONS', headers: { Origin: 'https://karizzmaa.github.io' } }), env);
+  const rewrapped = withCors(pre, new Request('https://x/', { method: 'OPTIONS', headers: { Origin: 'https://karizzmaa.github.io' } }), env);
+  assert.equal(rewrapped.headers.get('Access-Control-Allow-Origin'), 'https://karizzmaa.github.io');
+});
+
+test('withCors leaves disallowed and same-origin responses untouched', async () => {
+  const bad = new Request('https://x/functions/v1/contribute', { method: 'POST', headers: { Origin: 'https://evil.example' } });
+  const res = json({ error: 'Origin not allowed.' }, 403);
+  const out = withCors(res, bad, env);
+  assert.equal(out.status, 403);
+  assert.equal(out.headers.get('Access-Control-Allow-Origin'), null);
+
+  const direct = new Request('https://x/functions/v1/contribute', { method: 'POST' });  // server-to-server: no Origin
+  const out2 = withCors(json({ ok: true }), direct, env);
+  assert.equal(out2.headers.get('Access-Control-Allow-Origin'), null);
+});
+
 await run();
 console.log(`\n${passed} test groups passed${process.exitCode ? ' (with failures above)' : ''}.`);
diff --git a/supabase/functions/_shared/cors.js b/supabase/functions/_shared/cors.js
index 516df1f..3009beb
--- a/supabase/functions/_shared/cors.js
+++ b/supabase/functions/_shared/cors.js
@@ -1,6 +1,6 @@
 // CORS + JSON helpers. Allowed origins are supplied through the
-// ALLOWED_ORIGINS function secret (comma-separated); requests from anywhere
-// else are rejected before any work happens.
+// ALLOWED_ORIGINS function secret (comma-separated, "*" allows every origin);
+// requests from anywhere else are rejected before any work happens.
 
 export function json(body, status = 200, extraHeaders = {}) {
   return new Response(JSON.stringify(body), {
@@ -14,9 +14,21 @@ export function allowedOrigins(env) {
     .split(',').map((s) => s.trim()).filter(Boolean);
 }
 
+/** Origins are compared scheme+host+port only, so a trailing slash or
+ *  uppercase host in the secret cannot silently break matching. */
+export function normalizeOrigin(origin) {
+  try {
+    const u = new URL(String(origin));
+    return `${u.protocol}//${u.host.toLowerCase()}`;
+  } catch {
+    return String(origin ?? '').trim().replace(/\/+$/, '');
+  }
+}
+
 export function corsHeaders(env, origin) {
   const list = allowedOrigins(env);
-  return origin && list.includes(origin)
+  const ok = origin && (list.includes('*') || list.some((o) => normalizeOrigin(o) === normalizeOrigin(origin)));
+  return ok
     ? {
         'Access-Control-Allow-Origin': origin,
         'Access-Control-Allow-Headers': 'authorization, content-type, apikey, x-client-info',
@@ -47,3 +59,17 @@ export function checkOrigin(req, env) {
   }
   return { ok: true, headers };
 }
+
+/** The browser demands Access-Control-Allow-Origin on the ACTUAL response,
+ *  not just on the preflight — without it every POST dies as "NetworkError"
+ *  even when the preflight passed. Wrap each handler's response with this so
+ *  every reply to an allowed origin carries the headers. */
+export function withCors(response, req, env) {
+  const origin = req.headers.get('Origin');
+  if (!origin) return response;
+  const headers = corsHeaders(env, origin);
+  if (!headers['Access-Control-Allow-Origin']) return response;  // rejected upstream
+  const out = new Headers(response.headers);
+  for (const [k, v] of Object.entries(headers)) if (!out.has(k)) out.set(k, v);
+  return new Response(response.body, { status: response.status, statusText: response.statusText, headers: out });
+}
