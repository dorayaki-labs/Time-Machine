{
  // Cloudflare static-assets config for the Time Machine SPA.
  // Only needed if you deploy with `npx wrangler deploy` (Workers-style
  // project). A true Cloudflare Pages project does NOT use this file —
  // set Build output directory = dist in the dashboard instead.
  "name": "time-machine",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
