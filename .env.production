# The GitHub Pages site lives at dorayaki-labs.github.io/time-machine/ — bake
# the prefix into every production build so asset URLs are correct even when
# CI does not set VITE_BASE_PATH. An environment variable always wins over
# this file (the Cloudflare / root-domain builds run with VITE_BASE_PATH=/,
# and CF Pages builds always serve at the domain root).
VITE_BASE_PATH=/time-machine/
