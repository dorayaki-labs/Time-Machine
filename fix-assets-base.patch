diff --git a/.env.production b/.env.production
new file mode 100644
index 0000000..c064310
--- /dev/null
+++ b/.env.production
@@ -0,0 +1,5 @@
+# The GitHub Pages site lives at karrizzmaa.github.io/time-machine/ — bake the
+# prefix into every production build so asset URLs are correct even when CI
+# does not set VITE_BASE_PATH. An environment variable always wins over this
+# file (the Surge mirror builds with VITE_BASE_PATH=/).
+VITE_BASE_PATH=/time-machine/
